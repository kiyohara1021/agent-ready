{
  "name": "agent-ready",
  "version": "0.1.0",
  "description": "Is your repository ready for coding agents? A deterministic, local, read-only readiness audit CLI for Codex, Claude Code, Cursor and Copilot.",
  "type": "module",
  "license": "MIT",
  "author": "Yuta Kiyohara",
  "homepage": "https://github.com/kiyohara1021/agent-ready#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiyohara1021/agent-ready.git"
  },
  "bugs": {
    "url": "https://github.com/kiyohara1021/agent-ready/issues"
  },
  "keywords": [
    "coding-agent",
    "agents",
    "codex",
    "claude-code",
    "cursor",
    "developer-tools",
    "repository",
    "static-analysis",
    "cli",
    "devex",
    "agents-md",
    "agentic",
    "repository-analysis",
    "code-quality",
    "ci"
  ],
  "bin": {
    "agent-ready": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "docs/SCORING.md",
    "docs/DETECTORS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.10"
  }
}
